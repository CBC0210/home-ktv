# ============================================================================
# 響窩 Echonest / Home KTV — backend environment
# 複製為 .env 並填值。.env 不上 git（.env.example 才上）。
# 區域網自架：把 ADMIN_* 改掉、其餘多半可留空用預設即可。
# ============================================================================

# ─── 認證（公開部署前務必改） ───────────────────────────────────────────────
# Admin 後台（/admin）登入密碼
ADMIN_PASSWORD=admin
# Cookie/JWT 簽章密鑰 — 用 `openssl rand -hex 32` 產生
ADMIN_COOKIE_SECRET=changeme-replace-with-openssl-rand-hex-32
# 走 HTTPS 才設 true；plain-HTTP 區域網請留 false（否則 cookie 不會送）
COOKIE_SECURE=false

# ─── 部署 ──────────────────────────────────────────────────────────────────
# 對外網址（選用，目前僅備查；QR code 一律用瀏覽器當前網址，區域網自動正確）
PUBLIC_BASE_URL=
# 後端 port
LOCAL_PORT=8000
# 資料目錄（媒體永久快取 / DB / log）。預設為 repo 內 ./data
DATA_DIR=./data

# ─── 前端對接（注意：這是「前端」build 時的變數，不是後端讀的）──────────────
# 不設 → 前端自動連「同主機:8000」（區域網零設定）。
# 單一網域反向代理（Cloudflare/Nginx）後面 → 設為對外網址，例如：
#   echo 'NEXT_PUBLIC_API_URL=https://ktv.example.com' > frontend/.env.production.local
# （ws/wss 會自動從它推導；frontend/.env.production.local 已被 gitignore）

# ─── Cloudflare Tunnel（可選 — 只有要從外網存取才需要）──────────────────────
CF_TUNNEL_NAME=
CF_TUNNEL_UUID=
CF_DOMAIN=
CF_SUBDOMAIN=

# ─── GPU / Pipeline ────────────────────────────────────────────────────────
ENABLE_GPU=true
# Set false for CPU emergency operation; line-timed lyrics remain available.
ENABLE_WORD_ALIGNMENT=true
# WhisperX 模型：依 VRAM 選。4GB→small；6GB+→medium；large-v3 需 ~10GB
WHISPERX_MODEL=small
# Demucs 模型（htdemucs_ft 較佳但較吃資源；htdemucs 較輕）
DEMUCS_MODEL=htdemucs
# 單首歌處理硬上限（秒），逾時跳過（見 CLAUDE.md §21.2）
SONG_TOTAL_TIMEOUT_SEC=900
# 當前歌一開始播就預載接下來幾首
PREFETCH_COUNT=2
# 搜尋結果過濾：擋掉非歌曲（合輯/演唱會/直播/訪談），單位秒
SEARCH_MIN_DURATION_SEC=60
SEARCH_MAX_DURATION_SEC=600

# ─── LLM 標題清理（可選 — 把雜亂 YouTube 標題整理成 曲名/歌手/曲風）─────────
# 留空則用 regex 規則清理。相容 Anthropic Messages API 的端點皆可。
MINIMAX_API_KEY=
MINIMAX_BASE_URL=
MINIMAX_MODEL=

# ─── 第三方（可選）─────────────────────────────────────────────────────────
# 給有年齡限制影片用的 Netscape 格式 cookies 檔（留空 = 不用）
YOUTUBE_COOKIES_PATH=

# ─── Pipeline 重試 ─────────────────────────────────────────────────────────
PIPELINE_MAX_RETRIES=3
PIPELINE_HEARTBEAT_SEC=30

# ─── 首次啟動 ──────────────────────────────────────────────────────────────
# 全新資料庫會自動建立預設房間 home；這是它的房間密碼（留空 = 不設密碼，
# 私人區域網夠用；要給朋友從外網進來再設）
DEFAULT_ROOM_PASSWORD=

# ─── 日誌 ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                   # DEBUG / INFO / WARNING / ERROR
# 日誌一律寫在 DATA_DIR/logs 下（不再單獨設定）
DEV_MODE=false
