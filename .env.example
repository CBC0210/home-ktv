# ============================================================================
# Home KTV — Environment Configuration
# 複製此檔為 .env 並填入實際值。.env 絕對不上 git。
# ============================================================================

# ─── 認證 ──────────────────────────────────────────────────────────────────
# 管理員密碼（進入 /admin 用）
ADMIN_PASSWORD=BCktv210

# Cookie 簽章用（隨機 32 字元，可用 `openssl rand -hex 32` 產生）
ADMIN_COOKIE_SECRET=changeme-replace-with-openssl-rand-hex-32

# ─── 部署 ──────────────────────────────────────────────────────────────────
# 公開 URL（給 QR code 與 OG meta 用）
PUBLIC_BASE_URL=https://ktv.bc-verse.com

# 本機 FastAPI port
LOCAL_PORT=8000

# 資料目錄（媒體緩存、DB、log）
DATA_DIR=/data/ktv

# ─── Cloudflare ────────────────────────────────────────────────────────────
CF_TUNNEL_NAME=ktv
CF_TUNNEL_UUID=                 # 由 SETUP.md M0-T6 步驟取得
CF_DOMAIN=bc-verse.com
CF_SUBDOMAIN=ktv

# ─── GPU / Pipeline ────────────────────────────────────────────────────────
ENABLE_GPU=true

# 實際 GPU：GTX 1650 4GB（非規格書的 1660 Super 6GB）
# 4GB VRAM：建議從 small 開始，medium 需測試。large-v3 會 OOM。
WHISPERX_MODEL=small

# Demucs 模型（htdemucs_ft 為 SOTA）
DEMUCS_MODEL=htdemucs_ft

# 單首歌總 timeout（秒）— 詳見 CLAUDE.md §21.2
SONG_TOTAL_TIMEOUT_SEC=900       # 15 分鐘

# 預載下幾首
PREFETCH_COUNT=2

# ─── 第三方 API（可選）────────────────────────────────────────────────────
# YOUTUBE_COOKIES_PATH=/etc/ktv/yt-cookies.txt   # 給有年齡限制的影片用

# ─── 日誌與錯誤 ────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                   # DEBUG / INFO / WARNING / ERROR
LOG_DIR=/data/ktv/logs

# ─── 開發模式 ──────────────────────────────────────────────────────────────
DEV_MODE=false                   # true = 啟用熱重載、詳細錯誤頁
