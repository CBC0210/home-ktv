[Unit]
Description=Home KTV Backend (FastAPI)
Documentation=https://github.com/CBC0210/home-ktv
After=network.target
Wants=network-online.target

[Service]
Type=simple
# ⇩ Replace <USER> and <REPO_DIR> with your values, e.g.
#   sed -e "s|<USER>|$USER|g" -e "s|<REPO_DIR>|$HOME/home-ktv|g" \
#       deploy/ktv-backend.service.example | sudo tee /etc/systemd/system/ktv-backend.service
User=<USER>
Group=<USER>
WorkingDirectory=<REPO_DIR>/backend

# CUDA shared-library paths are resolved automatically at import time by
# ktv_pipeline.config (machine-independent) — no LD_LIBRARY_PATH needed.
Environment="PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True,garbage_collection_threshold:0.8"

# Load .env file for all app settings
EnvironmentFile=<REPO_DIR>/backend/.env

ExecStart=/usr/bin/env uv run uvicorn src.main:app \
    --host 0.0.0.0 \
    --port 8000 \
    --workers 1 \
    --log-level info

Restart=on-failure
RestartSec=10s
StartLimitBurst=5
StartLimitIntervalSec=300

# Security hardening
PrivateTmp=true
NoNewPrivileges=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ktv-backend

[Install]
WantedBy=multi-user.target
