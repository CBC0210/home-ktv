[Unit]
Description=Home KTV Frontend (Next.js)
Documentation=https://github.com/cbc/home-ktv
After=network.target ktv-backend.service
Wants=ktv-backend.service

[Service]
Type=simple
User=cbc
Group=cbc
WorkingDirectory=/home/cbc/home-ktv/frontend

Environment="NODE_ENV=production"
Environment="PORT=3000"

ExecStart=/usr/bin/pnpm start
ExecStartPre=/usr/bin/pnpm build

Restart=on-failure
RestartSec=10s
StartLimitBurst=3
StartLimitIntervalSec=300

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ktv-frontend

[Install]
WantedBy=multi-user.target
