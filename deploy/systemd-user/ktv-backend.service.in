[Unit]
Description=Home KTV FastAPI backend
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=@REPO_DIR@/backend
Environment="PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True,garbage_collection_threshold:0.8"
EnvironmentFile=@REPO_DIR@/.env
ExecStart="@UV@" run uvicorn src.main:app --host 0.0.0.0 --port 8000 --workers 1 --log-level info
Restart=on-failure
RestartSec=10s
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=default.target
